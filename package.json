{
  "name": "shared-copilot-chat",
  "displayName": "Shared Copilot Chat",
  "description": "Un chat Copilot à plusieurs dans VS Code : héberger ou rejoindre une session, agent confiné au projet de l'hôte avec validation des actions.",
  "version": "0.1.0",
  "publisher": "neo-schobert",
  "license": "MIT",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sharedCopilotChat.host",
        "title": "Host a Session",
        "category": "Shared Copilot",
        "icon": "$(broadcast)"
      },
      {
        "command": "sharedCopilotChat.join",
        "title": "Join a Session",
        "category": "Shared Copilot",
        "icon": "$(plug)"
      },
      {
        "command": "sharedCopilotChat.leave",
        "title": "Leave Session",
        "category": "Shared Copilot",
        "icon": "$(sign-out)"
      },
      {
        "command": "sharedCopilotChat.startSession",
        "title": "Start Session",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.copyInviteLink",
        "title": "Copy Invite Link",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.openChat",
        "title": "Open Chat",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.shareSelection",
        "title": "Share Selection",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.cancelResponse",
        "title": "Cancel Current Response",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.stopSession",
        "title": "Stop Session",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.selectModel",
        "title": "Select Default Model",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.resolveApproval",
        "title": "Resolve Approval",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.showDiff",
        "title": "Show Proposed Diff",
        "category": "Shared Copilot"
      },
      {
        "command": "sharedCopilotChat.answerQuestion",
        "title": "Answer Agent Question",
        "category": "Shared Copilot"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sharedCopilotChat.copyInviteLink",
          "when": "sharedCopilotChat.active"
        },
        {
          "command": "sharedCopilotChat.shareSelection",
          "when": "sharedCopilotChat.active"
        },
        {
          "command": "sharedCopilotChat.cancelResponse",
          "when": "sharedCopilotChat.active"
        },
        {
          "command": "sharedCopilotChat.stopSession",
          "when": "sharedCopilotChat.active"
        },
        {
          "command": "sharedCopilotChat.resolveApproval",
          "when": "false"
        },
        {
          "command": "sharedCopilotChat.showDiff",
          "when": "false"
        },
        {
          "command": "sharedCopilotChat.answerQuestion",
          "when": "false"
        },
        {
          "command": "sharedCopilotChat.startSession",
          "when": "false"
        },
        {
          "command": "sharedCopilotChat.leave",
          "when": "sharedCopilotChat.connected"
        }
      ],
      "editor/context": [
        {
          "command": "sharedCopilotChat.shareSelection",
          "when": "sharedCopilotChat.active",
          "group": "9_sharedCopilot"
        }
      ],
      "view/title": [
        {
          "command": "sharedCopilotChat.leave",
          "when": "view == sharedCopilotChat.view && sharedCopilotChat.connected",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Shared Copilot Chat",
      "properties": {
        "sharedCopilotChat.port": {
          "type": "integer",
          "default": 3717,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port local (127.0.0.1) du serveur de chat partagé."
        },
        "sharedCopilotChat.modelFamily": {
          "type": "string",
          "default": "",
          "description": "Famille du modèle Copilot utilisé par défaut (ex. « gpt-4o », « claude-sonnet-4 »). Vide : premier modèle Copilot disponible. Modifiable avec « Shared Copilot: Select Default Model »."
        },
        "sharedCopilotChat.allowGuestModelChoice": {
          "type": "boolean",
          "default": true,
          "description": "Autorise les invités à choisir un autre modèle pour leurs questions. Toutes les requêtes utilisent le quota Copilot de l'hôte, y compris les modèles premium."
        },
        "sharedCopilotChat.historyLength": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 200,
          "description": "Nombre d'échanges précédents envoyés au modèle avec chaque question."
        },
        "sharedCopilotChat.hostName": {
          "type": "string",
          "default": "",
          "description": "Votre pseudo dans les sessions, que vous hébergiez ou rejoigniez (vide : nom d'utilisateur système)."
        },
        "sharedCopilotChat.agentMode": {
          "type": "string",
          "enum": [
            "full",
            "readOnly",
            "off"
          ],
          "enumDescriptions": [
            "Lecture, modification de fichiers et commandes ; chaque modification ou commande est validée par l'auteur de la demande ou l'hôte (l'hôte seul pour les commandes hors du projet).",
            "Lecture, recherche et diagnostics uniquement.",
            "Aucun accès à l'espace de travail."
          ],
          "default": "full",
          "description": "Accès du modèle à l'espace de travail de l'hôte. Dans un espace de travail non approuvé, l'accès est limité à la lecture."
        },
        "sharedCopilotChat.nativeChat": {
          "type": "boolean",
          "default": true,
          "description": "Affiche les discussions de la session dans le panneau Chat natif de VS Code (API proposée : nécessite F5 ou --enable-proposed-api local.shared-copilot-chat)."
        },
        "sharedCopilotChat.protectedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Motifs glob supplémentaires de fichiers invisibles pour l'agent (s'ajoutent à la liste par défaut : .git, .env, clés, .npmrc, .ssh…)."
        },
        "sharedCopilotChat.sandboxReadOnlyPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Dossiers Linux supplémentaires visibles en lecture seule dans le bac à sable des commandes (ex. une chaîne d'outils installée hors de /usr ; sous WSL, chemins de la distribution). Les dossiers du PATH y sont déjà."
        },
        "sharedCopilotChat.wslSandbox": {
          "type": "boolean",
          "default": true,
          "description": "Sous Windows : isole les commandes de l'agent dans WSL avec bubblewrap (comme sous Linux) si WSL 2 et bubblewrap sont disponibles. Sinon, chaque commande doit être validée par l'hôte."
        },
        "sharedCopilotChat.wslDistro": {
          "type": "string",
          "default": "",
          "description": "Distribution WSL utilisée pour le bac à sable (vide : distribution par défaut)."
        },
        "sharedCopilotChat.wslMode": {
          "type": "string",
          "enum": [
            "ask",
            "reopen",
            "windows",
            "off"
          ],
          "enumDescriptions": [
            "Demander au démarrage d'une session s'il faut rouvrir le projet dans WSL.",
            "Toujours rouvrir le projet dans WSL (fonctionnement identique à Linux).",
            "Rester sous Windows (commandes isolées via WSL si possible).",
            "Ne rien proposer."
          ],
          "default": "ask",
          "description": "Sous Windows, si WSL est installé : que faire au démarrage d'une session. Ce qui manque (bubblewrap, extension WSL) est installé avec votre accord."
        }
      }
    },
    "chatSessions": [
      {
        "type": "shared-copilot",
        "name": "shared",
        "displayName": "Shared Copilot",
        "description": "Discussions de la session Shared Copilot partagée avec les invités",
        "when": "sharedCopilotChat.active"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sharedCopilot",
          "title": "Shared Copilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sharedCopilot": [
        {
          "type": "webview",
          "id": "sharedCopilotChat.view",
          "name": "Chat",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc -p . --noEmit && tsc -p src/web --noEmit",
    "test": "node esbuild.js --test && node dist/test/smoke.js",
    "vscode:prepublish": "npm run package",
    "test:vscode": "node esbuild.js && node esbuild.js --test && node test/vscode/run.js && node test/vscode/run.js --wsl",
    "package:marketplace": "npm run package && node scripts/package-marketplace.js",
    "test:view": "npm run package:marketplace && node esbuild.js --test && node test/vscode/run.js --view"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.136.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantPrivate",
    "chatParticipantAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b3fa8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neo-schobert/Copilot-Live-Share.git"
  },
  "bugs": {
    "url": "https://github.com/neo-schobert/Copilot-Live-Share/issues"
  },
  "homepage": "https://github.com/neo-schobert/Copilot-Live-Share#readme",
  "keywords": [
    "copilot",
    "chat",
    "collaboration",
    "pair programming",
    "live share",
    "agent"
  ]
}

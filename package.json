{
  "name": "prompt-share",
  "displayName": "Prompt Share",
  "description": "%extension.description%",
  "version": "0.1.6",
  "publisher": "neo-schobert",
  "license": "MIT",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "promptShare.host",
        "title": "%command.host%",
        "category": "Prompt Share",
        "icon": "$(broadcast)"
      },
      {
        "command": "promptShare.join",
        "title": "%command.join%",
        "category": "Prompt Share",
        "icon": "$(plug)"
      },
      {
        "command": "promptShare.leave",
        "title": "%command.leave%",
        "category": "Prompt Share",
        "icon": "$(sign-out)"
      },
      {
        "command": "promptShare.startTunnel",
        "title": "%command.startTunnel%",
        "category": "Prompt Share",
        "icon": "$(globe)"
      },
      {
        "command": "promptShare.stopTunnel",
        "title": "%command.stopTunnel%",
        "category": "Prompt Share",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "promptShare.shareApp",
        "title": "%command.shareApp%",
        "category": "Prompt Share",
        "icon": "$(browser)"
      },
      {
        "command": "promptShare.openConversationTab",
        "title": "%command.openConversationTab%",
        "category": "Prompt Share",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "promptShare.startSession",
        "title": "%command.startSession%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.copyInviteLink",
        "title": "%command.copyInviteLink%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.openChat",
        "title": "%command.openChat%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.shareSelection",
        "title": "%command.shareSelection%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.cancelResponse",
        "title": "%command.cancelResponse%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.stopSession",
        "title": "%command.stopSession%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.selectModel",
        "title": "%command.selectModel%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.resolveApproval",
        "title": "%command.resolveApproval%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.showDiff",
        "title": "%command.showDiff%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.answerQuestion",
        "title": "%command.answerQuestion%",
        "category": "Prompt Share"
      },
      {
        "command": "promptShare.reviewQuestion",
        "title": "%command.reviewQuestion%",
        "category": "Prompt Share"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "promptShare.copyInviteLink",
          "when": "promptShare.active"
        },
        {
          "command": "promptShare.shareSelection",
          "when": "promptShare.active"
        },
        {
          "command": "promptShare.cancelResponse",
          "when": "promptShare.active"
        },
        {
          "command": "promptShare.stopSession",
          "when": "promptShare.active"
        },
        {
          "command": "promptShare.resolveApproval",
          "when": "false"
        },
        {
          "command": "promptShare.showDiff",
          "when": "false"
        },
        {
          "command": "promptShare.answerQuestion",
          "when": "false"
        },
        {
          "command": "promptShare.reviewQuestion",
          "when": "false"
        },
        {
          "command": "promptShare.startSession",
          "when": "false"
        },
        {
          "command": "promptShare.leave",
          "when": "promptShare.connected"
        },
        {
          "command": "promptShare.openConversationTab",
          "when": "promptShare.connected"
        },
        {
          "command": "promptShare.startTunnel",
          "when": "promptShare.active"
        },
        {
          "command": "promptShare.stopTunnel",
          "when": "promptShare.active"
        },
        {
          "command": "promptShare.shareApp",
          "when": "promptShare.active"
        }
      ],
      "editor/context": [
        {
          "command": "promptShare.shareSelection",
          "when": "promptShare.active",
          "group": "9_promptShare"
        }
      ],
      "view/title": [
        {
          "command": "promptShare.openConversationTab",
          "when": "view == promptShare.view && promptShare.connected",
          "group": "navigation"
        },
        {
          "command": "promptShare.leave",
          "when": "view == promptShare.view && promptShare.connected",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Prompt Share",
      "properties": {
        "promptShare.port": {
          "type": "integer",
          "default": 3717,
          "minimum": 1,
          "maximum": 65535,
          "description": "%config.port.description%"
        },
        "promptShare.modelFamily": {
          "type": "string",
          "default": "",
          "description": "%config.modelFamily.description%"
        },
        "promptShare.language": {
          "type": "string",
          "enum": [
            "auto",
            "fr",
            "en",
            "de"
          ],
          "enumDescriptions": [
            "%config.language.enum.0%",
            "%config.language.enum.1%",
            "%config.language.enum.2%",
            "%config.language.enum.3%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "promptShare.tunnelProvider": {
          "type": "string",
          "enum": [
            "cloudflare",
            "ngrok"
          ],
          "enumDescriptions": [
            "%config.tunnelProvider.enum.0%",
            "%config.tunnelProvider.enum.1%"
          ],
          "default": "cloudflare",
          "description": "%config.tunnelProvider.description%"
        },
        "promptShare.notifications": {
          "type": "string",
          "enum": [
            "decisions",
            "all",
            "off"
          ],
          "enumDescriptions": [
            "%config.notifications.enum.0%",
            "%config.notifications.enum.1%",
            "%config.notifications.enum.2%"
          ],
          "default": "decisions",
          "description": "%config.notifications.description%"
        },
        "promptShare.reviewGuestQuestions": {
          "type": "boolean",
          "default": true,
          "description": "%config.reviewGuestQuestions.description%"
        },
        "promptShare.guestQuestionsPerHour": {
          "type": "integer",
          "default": 60,
          "minimum": 0,
          "maximum": 1000,
          "description": "%config.guestQuestionsPerHour.description%"
        },
        "promptShare.allowGuestModelChoice": {
          "type": "boolean",
          "default": false,
          "description": "%config.allowGuestModelChoice.description%"
        },
        "promptShare.historyLength": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 200,
          "description": "%config.historyLength.description%"
        },
        "promptShare.hostName": {
          "type": "string",
          "default": "",
          "description": "%config.hostName.description%"
        },
        "promptShare.agentMode": {
          "type": "string",
          "enum": [
            "full",
            "readOnly",
            "off"
          ],
          "enumDescriptions": [
            "%config.agentMode.enum.0%",
            "%config.agentMode.enum.1%",
            "%config.agentMode.enum.2%"
          ],
          "default": "full",
          "description": "%config.agentMode.description%"
        },
        "promptShare.nativeChat": {
          "type": "boolean",
          "default": true,
          "description": "%config.nativeChat.description%"
        },
        "promptShare.protectedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.protectedFiles.description%"
        },
        "promptShare.sandboxReadOnlyPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.sandboxReadOnlyPaths.description%"
        },
        "promptShare.wslSandbox": {
          "type": "boolean",
          "default": true,
          "description": "%config.wslSandbox.description%"
        },
        "promptShare.wslDistro": {
          "type": "string",
          "default": "",
          "description": "%config.wslDistro.description%"
        },
        "promptShare.wslMode": {
          "type": "string",
          "enum": [
            "ask",
            "reopen",
            "windows",
            "off"
          ],
          "enumDescriptions": [
            "%config.wslMode.enum.0%",
            "%config.wslMode.enum.1%",
            "%config.wslMode.enum.2%",
            "%config.wslMode.enum.3%"
          ],
          "default": "ask",
          "description": "%config.wslMode.description%"
        }
      }
    },
    "chatSessions": [
      {
        "type": "prompt-share",
        "name": "shared",
        "displayName": "Prompt Share",
        "description": "%chatSessions.description%",
        "when": "promptShare.active"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptShare",
          "title": "Prompt Share",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptShare": [
        {
          "type": "webview",
          "id": "promptShare.view",
          "name": "Chat",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc -p . --noEmit && tsc -p src/web --noEmit",
    "test": "node esbuild.js --test && node dist/test/smoke.js",
    "vscode:prepublish": "npm run package",
    "test:vscode": "node esbuild.js && node esbuild.js --test && node test/vscode/run.js && node test/vscode/run.js --wsl",
    "package:marketplace": "npm run package && node scripts/package-marketplace.js",
    "test:tunnel": "node esbuild.js && node esbuild.js --test && node test/vscode/run.js --tunnel",
    "test:view": "npm run package:marketplace && node esbuild.js --test && node test/vscode/run.js --view"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.136.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantPrivate",
    "chatParticipantAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b3fa8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neo-schobert/Prompt-Share.git"
  },
  "bugs": {
    "url": "https://github.com/neo-schobert/Prompt-Share/issues"
  },
  "homepage": "https://github.com/neo-schobert/Prompt-Share#readme",
  "keywords": [
    "copilot",
    "chat",
    "collaboration",
    "pair programming",
    "agent"
  ]
}
